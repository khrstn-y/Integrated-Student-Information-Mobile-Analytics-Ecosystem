<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StudentInformationSystemMobile.Views.MyProfilePage"
    Title="CS Student Management System">

    <ContentPage.Resources>
        <Style x:Key="ProfileCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="#1A237E" />
        </Style>

        <Style x:Key="FieldCaption" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="#607D8B" />
        </Style>

        <Style x:Key="FieldValue" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="#212121" />
        </Style>

        <Style x:Key="ProfileEntry" TargetType="Entry">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="#212121" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Image Aspect="AspectFill" Source="bg.png" />

        <Grid RowDefinitions="Auto,*">
            <Grid
                BackgroundColor="#1A237E"
                ColumnDefinitions="*,Auto,*"
                Padding="12,8">

                <Button
                    BackgroundColor="Transparent"
                    Clicked="OnBackClicked"
                    HorizontalOptions="Start"
                    Text="← Back"
                    TextColor="#FFC107" />

                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="My Profile"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="14,12,14,24" Spacing="12">

                    <!-- Signed-in student -->
                    <Border Style="{StaticResource ProfileCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                x:Name="FullNameHeaderLabel"
                                FontSize="18"
                                Style="{StaticResource SectionTitle}" />

                            <Label
                                x:Name="StudentIdLabel"
                                Style="{StaticResource FieldValue}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Academic information -->
                    <Border Style="{StaticResource ProfileCard}">
                        <VerticalStackLayout Spacing="10">
                            <Label
                                Style="{StaticResource SectionTitle}"
                                Text="Academic Information" />

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="12"
                                RowDefinitions="Auto,Auto"
                                RowSpacing="10">

                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        x:Name="ProgramCaptionLabel"
                                        Style="{StaticResource FieldCaption}"
                                        Text="Program" />

                                    <Label
                                        x:Name="ProgramLabel"
                                        LineBreakMode="WordWrap"
                                        Style="{StaticResource FieldValue}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label
                                        Style="{StaticResource FieldCaption}"
                                        Text="Enrollment Status" />

                                    <Label
                                        x:Name="StatusLabel"
                                        Style="{StaticResource FieldValue}"
                                        TextColor="#2E7D32" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="1" Spacing="2">
                                    <Label
                                        Style="{StaticResource FieldCaption}"
                                        Text="Year Level" />

                                    <Label
                                        x:Name="YearLevelLabel"
                                        Style="{StaticResource FieldValue}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Spacing="2">
                                    <Label
                                        Style="{StaticResource FieldCaption}"
                                        Text="Block" />

                                    <Label
                                        x:Name="BlockLabel"
                                        Style="{StaticResource FieldValue}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Personal information -->
                    <Border Style="{StaticResource ProfileCard}">
                        <VerticalStackLayout Spacing="10">
                            <Label
                                Style="{StaticResource SectionTitle}"
                                Text="Personal Information" />

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="12"
                                RowDefinitions="Auto,Auto,Auto,Auto"
                                RowSpacing="8">

                                <VerticalStackLayout>
                                    <Label
                                        Style="{StaticResource FieldCaption}"
                                        Text="First Name" />
                                    <Entry
                                        x:Name="FirstNameEntry"
                                        Style="{StaticResource ProfileEntry}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1">
                                    <Label
                                        Style="{StaticResource FieldCaption}"
                                        Text="Middle Name" />
                                    <Entry
                                        x:Name="MiddleNameEntry"
                                        Style="{StaticResource ProfileEntry}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="1">
                                    <Label
                                        Style="{StaticResource FieldCaption}"
                                        Text="Last Name" />
                                    <Entry
                                        x:Name="LastNameEntry"
                                        Style="{StaticResource ProfileEntry}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                    <Label
                                        Style="{StaticResource FieldCaption}"
                                        Text="Contact Number" />
                                    <Entry
                                        x:Name="ContactEntry"
                                        Style="{StaticResource ProfileEntry}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2">
                                    <Label
                                        Style="{StaticResource FieldCaption}"
                                        Text="Email Address" />
                                    <Entry
                                        x:Name="EmailEntry"
                                        Style="{StaticResource ProfileEntry}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="3">
                                    <Label
                                        Style="{StaticResource FieldCaption}"
                                        Text="Date of Birth" />
                                    <Entry
                                        x:Name="DobEntry"
                                        Style="{StaticResource ProfileEntry}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="3" Grid.Column="1">
                                    <Label
                                        Style="{StaticResource FieldCaption}"
                                        Text="Gender" />
                                    <Entry
                                        x:Name="GenderEntry"
                                        Style="{StaticResource ProfileEntry}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button
                            x:Name="EditButton"
                            BackgroundColor="#FFC107"
                            Clicked="OnEditClicked"
                            IsEnabled="False"
                            Text="Edit Profile"
                            TextColor="#1A237E" />

                        <Button
                            x:Name="SaveButton"
                            Grid.Column="1"
                            BackgroundColor="#2E7D32"
                            Clicked="OnSaveClicked"
                            IsEnabled="False"
                            Text="Save Changes"
                            TextColor="White" />
                    </Grid>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>