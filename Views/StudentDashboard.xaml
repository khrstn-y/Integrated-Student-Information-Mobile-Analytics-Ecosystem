<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StudentInformationSystemMobile.Views.StudentDashboard"
    Title="Student Dashboard">

    <Grid>
        <Image Aspect="AspectFill" Source="bg.png" />

        <Grid RowDefinitions="Auto,*">
            <Grid
                BackgroundColor="#CC1A237E"
                ColumnDefinitions="Auto,*"
                Padding="16,12">

                <Image
                    Aspect="AspectFit"
                    HeightRequest="36"
                    Source="logo.png"
                    WidthRequest="36" />

                <VerticalStackLayout
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="BU College of Science"
                        TextColor="White" />
                    <Label
                        FontSize="11"
                        Text="Student Information System"
                        TextColor="#FFC107" />
                </VerticalStackLayout>
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="18,16" Spacing="16">

                    <Frame
                        BackgroundColor="White"
                        CornerRadius="15"
                        HasShadow="True"
                        Padding="16">
                        <VerticalStackLayout Spacing="3">
                            <Label
                                FontSize="12"
                                Text="Welcome back, Scholar!"
                                TextColor="Gray" />
                            <Label
                                x:Name="WelcomeNameLabel"
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="Loading student..."
                                TextColor="#1A237E" />
                            <Label
                                x:Name="StudentSummaryLabel"
                                FontSize="12"
                                TextColor="#455A64" />

                            <Frame
                                x:Name="StatusBadge"
                                BackgroundColor="#E8F5E9"
                                CornerRadius="6"
                                HasShadow="False"
                                HorizontalOptions="Start"
                                IsVisible="False"
                                Margin="0,2,0,0"
                                Padding="8,2">
                                <Label
                                    x:Name="StatusBadgeLabel"
                                    FontAttributes="Bold"
                                    FontSize="11"
                                    TextColor="#2E7D32" />
                            </Frame>
                        </VerticalStackLayout>
                    </Frame>

                    <Label
                        FontAttributes="Bold"
                        FontSize="15"
                        Margin="4,4,0,-6"
                        Text="Quick Navigation"
                        TextColor="White" />

                    <Frame
                        BackgroundColor="White"
                        CornerRadius="14"
                        HasShadow="True"
                        Padding="16">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStudentDirectoryClicked" />
                        </Frame.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Frame
                                BackgroundColor="#E8EAF6"
                                CornerRadius="12"
                                HasShadow="False"
                                HeightRequest="50"
                                WidthRequest="50">
                                <Label
                                    FontSize="24"
                                    HorizontalOptions="Center"
                                    Text="👥"
                                    VerticalOptions="Center" />
                            </Frame>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="Student Directory"
                                    TextColor="#1A237E" />
                                <Label
                                    FontSize="12"
                                    Text="Search and view College of Science students"
                                    TextColor="#607D8B" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                FontAttributes="Bold"
                                FontSize="20"
                                Text="›"
                                TextColor="#1A237E"
                                VerticalOptions="Center" />
                        </Grid>
                    </Frame>

                    <Frame
                        BackgroundColor="White"
                        CornerRadius="14"
                        HasShadow="True"
                        Padding="16">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMyProfileClicked" />
                        </Frame.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Frame
                                BackgroundColor="#FFF8E1"
                                CornerRadius="12"
                                HasShadow="False"
                                HeightRequest="50"
                                WidthRequest="50">
                                <Label
                                    FontSize="24"
                                    HorizontalOptions="Center"
                                    Text="👤"
                                    VerticalOptions="Center" />
                            </Frame>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="My Profile"
                                    TextColor="#1A237E" />
                                <Label
                                    FontSize="12"
                                    Text="View and update your personal details"
                                    TextColor="#607D8B" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                FontAttributes="Bold"
                                FontSize="20"
                                Text="›"
                                TextColor="#1A237E"
                                VerticalOptions="Center" />
                        </Grid>
                    </Frame>

                    <Button
                        BackgroundColor="Transparent"
                        Clicked="OnLogoutClicked"
                        FontAttributes="Bold"
                        FontSize="15"
                        HorizontalOptions="End"
                        Margin="0,12,20,24"
                        Text="← Log Out"
                        TextColor="White"
                        VerticalOptions="End" />

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>